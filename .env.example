# Database, copied field by field from hPanel -> Databases -> Management.
# No need to build a connection string or escape anything: paste the values as
# they appear. DB_HOST and DB_PORT can be left out (localhost:3306 is assumed).
DB_NAME="u123456789_ozmo"
DB_USER="u123456789_ozmo"
DB_PASSWORD="CHANGE_ME"
DB_HOST="localhost"
DB_PORT="3306"
# Shared hosting caps how many connections one user may hold. Change only if
# Hostinger support tells you to.
DB_CONNECTION_LIMIT="5"
DB_POOL_TIMEOUT="10"
# Optional: a full connection string instead of the fields above (CI and tools).
# When set, it wins and the DB_* values are ignored.
# DATABASE_URL="mysql://user:password@localhost:3306/database?connection_limit=5&pool_timeout=10"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# Hostinger's web-app runtime has one. Rate limits use only the address those
# proxies wrote; set 0 if nothing sits in front of the app.
TRUSTED_PROXY_COUNT="1"
# Optional but recommended: HTTPS webhook that receives a short JSON alert for
# every server error (a Slack/Discord incoming webhook works). Alerts carry the
# error type, database code and route only — never request data.
ERROR_WEBHOOK_URL=""
# Email (hPanel -> Emails -> Configuration settings). Without SMTP_HOST and
# EMAIL_FROM nothing is emailed: invites and links are shown to staff to share
# by hand, and every attempt is listed in Practice -> Notifications.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="hello@ozmodietclinic.com"
SMTP_PASSWORD=""
EMAIL_FROM="Ozmo Diet Clinic <hello@ozmodietclinic.com>"
# Where alerts about new bookings, assessments and enquiries go. Blank = no alerts.
CLINIC_NOTIFY_EMAIL=""
# Encrypts uploaded client documents (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Keep a copy in the password manager. Losing or changing it makes stored
# documents unreadable. Blank = document uploads are turned off.
DOCUMENT_ENCRYPTION_KEY=""
# Final canonical HTTPS URL, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://ozmodietclinic.com"
# Required only for the first production bootstrap. Use distinct random values,
# then remove them from hPanel after both staff accounts have been verified.
SEED_ADMIN_EMAIL="admin@ozmodietclinic.com"
SEED_ADMIN_PASSWORD="generate-a-unique-20-plus-character-password"
SEED_DIETITIAN_EMAIL="dietitian@ozmodietclinic.com"
SEED_DIETITIAN_PASSWORD="generate-another-unique-20-plus-character-password"
