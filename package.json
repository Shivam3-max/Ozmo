{
  "name": "ozmo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3680",
    "prebuild": "prisma generate",
    "build": "next build",
    "validate:env": "node scripts/validate-env.mjs",
    "hostinger:build": "npm run validate:env && prisma generate && prisma migrate deploy && next build",
    "hostinger:init": "npm run validate:env && prisma generate && prisma migrate deploy && prisma db seed && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:e2e": "playwright test",
    "retention:run": "tsx scripts/retention.ts",
    "retention:preview": "tsx scripts/retention.ts --dry-run",
    "test:regression": "node scripts/regression/run.mjs",
    "smoke": "node scripts/smoke.mjs",
    "restore:check": "node scripts/restore-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "next": "^16.3.4",
    "nodemailer": "10.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "5.0.0"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "unrs-resolver@1.12.2": true
  }
}
